{
  "name": "@streamreader/desktop",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "description": "StreamReader Desktop App",
  "author": {
    "name": "StreamReader Team",
    "email": "hello@streamreader.com"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "preview": "vite preview",
    "lint": "eslint src"
  },
  "dependencies": {
    "@streamreader/core": "*",
    "@streamreader/ui": "*",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.1.7",
    "lucide-react": "^0.312.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "28.2.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  },
  "build": {
    "appId": "com.streamreader.app",
    "productName": "StreamReader",
    "copyright": "Copyright © 2024 StreamReader",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ]
  }
}
