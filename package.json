{
  "name": "streamreader",
  "version": "0.1.0",
  "private": true,
  "description": "Speed reading app using RSVP technique",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@streamreader/web",
    "dev:web": "npm run dev --workspace=@streamreader/web",
    "dev:desktop": "npm run dev --workspace=@streamreader/desktop",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=@streamreader/web",
    "build:desktop": "npm run build --workspace=@streamreader/desktop",
    "package:desktop": "npm run package --workspace=@streamreader/desktop",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "clean": "rm -rf node_modules packages/*/node_modules"
  },
  "keywords": [
    "speed-reading",
    "rsvp",
    "reader",
    "ebook"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
